{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-funding-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // nodejs_compat lets the official OpenAI SDK run on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    // gpt-5-nano is the intended model: this assistant explains supplied text,
    // summarises retrieved passages, and picks from an allow-list of actions.
    // Change here to upgrade; no code change is needed.
    "OPENAI_MODEL": "gpt-5-nano",
    "OPENAI_MAX_OUTPUT_TOKENS": "1400",
    "OPENAI_REASONING_EFFORT": "minimal",

    // Exact origins only - an Origin header has no path, so the GitHub Pages
    // project path cannot be part of this value.
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://kwasant7.github.io",

    // Applied only when a DAILY_KV namespace is bound; otherwise ignored.
    "DAILY_MESSAGE_CAP": "200"
  },

  // OPENAI_API_KEY is a secret, never a var:
  //   wrangler secret put OPENAI_API_KEY

  "ratelimits": [
    {
      "name": "BURST_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 10 }
    },
    {
      "name": "SUSTAINED_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 15, "period": 60 }
    }
  ]

  // Optional daily cap. Create a namespace, then uncomment:
  //   wrangler kv namespace create ASSISTANT_DAILY
  // "kv_namespaces": [
  //   { "binding": "DAILY_KV", "id": "<id printed by the command above>" }
  // ]
}
