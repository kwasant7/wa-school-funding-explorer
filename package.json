{
  "name": "wa-school-funding-explorer",
  "version": "1.0.0",
  "description": "An interactive explainer and dashboard for Washington State's K-12 school funding system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-data": "node scripts/fetch-data.mjs",
    "fetch-spending": "node scripts/build-program-spending.mjs",
    "fetch-legislators": "node scripts/fetch-legislators.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker:dev": "npm --prefix assistant-worker run dev",
    "worker:deploy": "npm --prefix assistant-worker run deploy",
    "worker:test": "npm --prefix assistant-worker test"
  },
  "license": "MIT",
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "polygon-clipping": "^0.15.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
